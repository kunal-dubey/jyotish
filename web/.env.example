# LLM — use either OpenRouter OR direct Anthropic (not both as primary).
# OpenRouter default: Claude Sonnet (quality for falsifiable past-check claims).
# Adaptive thinking is OFF on OpenRouter unless OPENROUTER_THINKING=1 (keeps stages under Vercel 300s).
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_MODEL=anthropic/claude-sonnet-5.5

# Optional: enable Anthropic adaptive thinking via OpenRouter (risk of 300s timeouts)
# OPENROUTER_THINKING=1

# Or Anthropic direct:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional per-stage overrides:
# ANTHROPIC_MODEL_PAST=anthropic/claude-sonnet-5.5
# ANTHROPIC_MODEL_REPORTS=anthropic/claude-sonnet-5.5
#
# Fallbacks on 429 only (max 3). Default: Gemini Flash → DeepSeek → Gemma free
# OPENROUTER_FALLBACKS=google/gemini-2.5-flash,deepseek/deepseek-v3.2,google/gemma-4-31b-it:free

# Chart service — local Docker/compose or uvicorn
CHART_SERVICE_URL=http://127.0.0.1:8765
# On Vercel, set this to the chart project URL, e.g.:
# CHART_SERVICE_URL=https://jyotish-chart.vercel.app

# MongoDB — local compose, or Atlas (Vercel Marketplace → MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/jyotish

# Random secret for JWT session cookies (32+ bytes)
# openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://your-app.vercel.app
# OPENROUTER_APP_TITLE=Jyotish Protocol
