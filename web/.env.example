# LLM — use either OpenRouter OR direct Anthropic (not both as primary).
# OpenRouter (recommended if you have an sk-or- key):
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_MODEL=anthropic/claude-opus-5.5

# Or Anthropic direct:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Chart service — local Docker/compose or uvicorn
CHART_SERVICE_URL=http://127.0.0.1:8765
# On Vercel, set this to the chart project URL, e.g.:
# CHART_SERVICE_URL=https://jyotish-chart.vercel.app

# MongoDB — local compose, or Atlas (Vercel Marketplace → MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/jyotish
# Staging/production example:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/jyotish?retryWrites=true&w=majority

# Random secret for JWT session cookies (32+ bytes)
# openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string

# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=https://your-app.vercel.app
# OPENROUTER_APP_TITLE=Jyotish Protocol
